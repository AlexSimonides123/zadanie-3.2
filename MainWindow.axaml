<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="notatnik.MainWindow"
        Title="Notatnik"
        Width="900"
        Height="560"
        MinWidth="640"
        MinHeight="400">
    <Grid ColumnDefinitions="280,*" Margin="16">
        <DockPanel Margin="0,0,16,0">
            <TextBlock DockPanel.Dock="Top"
                       Text="Zapisane notatki"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <ListBox x:Name="NotesList"
                     SelectionChanged="NotesList_OnSelectionChanged" />
        </DockPanel>

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*,Auto">
            <TextBlock Text="Tytuł"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <TextBox x:Name="TitleBox"
                     Grid.Row="1"
                     PlaceholderText="Tytuł notatki"
                     Margin="0,0,0,12" />
            <TextBlock Grid.Row="2"
                       Text="Treść"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <TextBox x:Name="ContentBox"
                     Grid.Row="3"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     PlaceholderText="Treść notatki"
                     Margin="0,0,0,12" />
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="Nowa"
                        MinWidth="100"
                        Click="NewButton_OnClick" />
                <Button x:Name="SaveButton"
                        Content="Zapisz"
                        MinWidth="120"
                        Click="SaveButton_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
